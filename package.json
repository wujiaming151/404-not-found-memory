{
  "name": "404-not-found",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "migrate:cloudflare": "wrangler d1 migrations apply memory-reconstruction --remote --config wrangler.jsonc",
    "deploy:vinext": "pnpm run migrate:cloudflare && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "next": "^16.0.0",
    "next-intl": "^4.14.2",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "three": "^0.185.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.2.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
